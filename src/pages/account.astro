---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="My Dashboard | HelpMeDost">
<section class="page-hero"><div class="container"><span class="eyebrow">My HelpMeDost</span><h1>Your personal dashboard</h1><p>Manage your questions, requests, payments and account from one place.</p></div></section>
<section class="container user-dashboard">
  <div class="dashboard-welcome form-shell">
    <div><span class="eyebrow">Personal account</span><h2 id="welcome-title">Welcome back</h2><p id="identity" role="status">Checking your secure sign-in…</p></div>
    <button class="button button-light" id="logout" type="button">Sign out</button>
  </div>

  <nav class="dashboard-actions" aria-label="Account actions">
    <a class="dashboard-action" href="/paid-help"><span class="dashboard-icon">✉</span><strong>Ask a Question</strong><small>Submit a new question for assistance</small></a>
    <a class="dashboard-action" href="/request-help"><span class="dashboard-icon">＋</span><strong>Request Help</strong><small>Send a general help request</small></a>
    <a class="dashboard-action" href="/track"><span class="dashboard-icon">⌕</span><strong>Track a Request</strong><small>Check the status of a request</small></a>
    <a class="dashboard-action" href="#payment-history"><span class="dashboard-icon">₹</span><strong>Payment History</strong><small>View payments, refunds and subscriptions</small></a>
  </nav>

  <section class="dashboard-section" id="my-questions">
    <div class="dashboard-heading"><div><span class="eyebrow">Your activity</span><h2>My Questions</h2><p>Paid questions and questions submitted using subscription credits.</p></div><a class="button" href="/paid-help">Ask a Question →</a></div>
    <div id="queries" class="dashboard-list" aria-live="polite">Loading your questions…</div>
    <div id="credit-queries" class="dashboard-list"></div>
  </section>

  <section class="dashboard-section" id="payment-history">
    <div class="dashboard-heading"><div><span class="eyebrow">Account activity</span><h2>Payment History</h2><p>Review payment status, refunds and your support plans.</p></div></div>
    <h3 class="dashboard-subheading">One-time payments</h3>
    <div id="payments" class="dashboard-list" aria-live="polite">Loading payment history…</div>
    <h3 class="dashboard-subheading">Subscriptions</h3>
    <div id="subscriptions" class="dashboard-list" aria-live="polite">Loading subscriptions…</div>
  </section>

  <section class="dashboard-section" id="account-help">
    <div class="dashboard-heading"><div><span class="eyebrow">Need assistance?</span><h2>Account & Support</h2><p>For account-related help, contact the HelpMeDost support team.</p></div><a class="button button-light" href="/request-help">Contact Support →</a></div>
  </section>
</section>
<style>
.user-dashboard{padding-bottom:76px}.dashboard-welcome{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:28px 0}.dashboard-welcome h2{margin:8px 0}.dashboard-welcome p{margin:0;color:var(--muted,#64748b);overflow-wrap:anywhere}.dashboard-actions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:24px 0 42px}.dashboard-action{display:flex;flex-direction:column;gap:8px;padding:20px;border:1px solid var(--line,#dbe3ec);border-radius:14px;background:var(--surface,#fff);color:inherit;text-decoration:none;min-height:142px}.dashboard-action:hover{border-color:var(--brand,#2563eb);transform:translateY(-1px)}.dashboard-icon{font-size:24px;color:var(--brand,#2563eb)}.dashboard-action strong{font-size:16px}.dashboard-action small{color:var(--muted,#64748b);line-height:1.5}.dashboard-section{padding:28px 0;border-top:1px solid var(--line,#dbe3ec);scroll-margin-top:24px}.dashboard-heading{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:18px}.dashboard-heading h2{margin:5px 0}.dashboard-heading p{margin:0;color:var(--muted,#64748b)}.dashboard-subheading{margin:24px 0 12px}.dashboard-list{display:grid;gap:12px}.dashboard-card{border:1px solid var(--line,#dbe3ec);border-radius:12px;padding:18px;background:var(--surface,#fff)}.dashboard-card h3{margin:0 0 8px}.dashboard-card p{margin:6px 0;overflow-wrap:anywhere}.dashboard-meta{color:var(--muted,#64748b);font-size:13px}.dashboard-empty{padding:18px;border:1px dashed var(--line,#cbd5e1);border-radius:12px;color:var(--muted,#64748b)}.dashboard-card .button{margin-top:10px}@media(max-width:760px){.dashboard-actions{grid-template-columns:repeat(2,minmax(0,1fr))}.dashboard-heading{align-items:flex-start;flex-direction:column}}@media(max-width:420px){.dashboard-actions{grid-template-columns:1fr}.dashboard-welcome{align-items:flex-start;flex-direction:column}}
</style>
<script>
import { logoutFirebase } from "../scripts/firebase-client";
const identity = document.querySelector("#identity");
const welcome = document.querySelector("#welcome-title");
const queries = document.querySelector("#queries");
const creditQueries = document.querySelector("#credit-queries");
const payments = document.querySelector("#payments");
const subscriptions = document.querySelector("#subscriptions");
function el(tag, value) { const node = document.createElement(tag); if (value !== undefined) node.textContent = value; return node; }
function empty(target, message) { target.replaceChildren(el("div", message)); target.firstElementChild.className = "dashboard-empty"; }
function card(title, lines) {
  const article = el("article"); article.className = "dashboard-card";
  article.append(el("h3", title));
  for (const line of lines) if (line) article.append(el("p", line));
  return article;
}
async function loadDashboard() {
  try {
    const meResponse = await fetch("/api/auth/me", { cache: "no-store" });
    const me = await meResponse.json();
    if (!meResponse.ok || me.user?.purpose !== "user" || me.user?.user_type !== "public") {
      location.href = "/login?next=%2Faccount"; return;
    }
    welcome.textContent = "Welcome, " + (me.user.full_name || "there");
    identity.textContent = me.user.email;
    const response = await fetch("/api/payments/mine", { cache: "no-store" });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || "Unable to load your account activity.");

    const paid = Array.isArray(data.queries) ? data.queries : [];
    const credits = Array.isArray(data.creditQueries) ? data.creditQueries : [];
    const plans = Array.isArray(data.subscriptions) ? data.subscriptions : [];

    if (!paid.length && !credits.length) empty(queries, "You have not asked any questions yet. Select “Ask a Question” to get started.");
    else {
      queries.replaceChildren();
      paid.forEach(q => {
        const item = card(q.subject || "Help request", [
          "Reference: " + q.reference_code,
          "Amount: ₹" + q.amount_inr + " · Payment: " + q.payment_status + " · Query: " + q.status,
          "Refund: " + (q.refund_status || "Not applicable"),
          q.description,
          q.response_message ? "HelpMeDost response: " + q.response_message : (q.payment_status === "paid" ? "Your question is in our response queue." : "")
        ]);
        if (q.created_at) item.append(el("p", "Submitted: " + new Date(q.created_at).toLocaleString()));
        queries.append(item);
      });
    }

    if (!credits.length) empty(creditQueries, "No questions submitted using subscription credits yet.");
    else {
      creditQueries.replaceChildren();
      credits.forEach(q => creditQueries.append(card(q.subject || "Subscription question", [
        "Reference: " + q.reference_code + " · Status: " + q.status,
        q.response_message ? "HelpMeDost response: " + q.response_message : "No response has been recorded yet.",
        q.created_at ? "Submitted: " + new Date(q.created_at).toLocaleString() : ""
      ])));
    }

    if (!paid.length) empty(payments, "No one-time payments found.");
    else {
      payments.replaceChildren();
      paid.forEach(q => payments.append(card(q.subject || "Question payment", [
        "Reference: " + q.reference_code,
        "₹" + q.amount_inr + " · " + q.payment_status,
        "Refund status: " + (q.refund_status || "Not applicable"),
        q.paid_at ? "Paid on: " + new Date(q.paid_at).toLocaleString() : "Payment date not available"
      ])));
    }

    if (!plans.length) empty(subscriptions, "You do not have any subscriptions yet.");
    else {
      subscriptions.replaceChildren();
      plans.forEach(s => {
        const item = card(s.plan_name + " · " + s.status, [
          "Reference: " + s.reference_code,
          "Payment: " + s.payment_status + " · Credits remaining: " + s.query_credits_remaining,
          s.ends_at ? "Current period ends: " + new Date(s.ends_at).toLocaleString() : ""
        ]);
        if (s.status === "active" && Number(s.query_credits_remaining) > 0) {
          const use = el("a", "Use a question credit →"); use.href = "/subscription-help"; use.className = "button"; item.append(use);
        }
        subscriptions.append(item);
      });
    }
  } catch (error) {
    const message = error instanceof Error ? error.message : "Unable to load your dashboard.";
    identity.textContent = message;
    empty(queries, "Your account activity could not be loaded. Please refresh and try again.");
    empty(payments, message);
    empty(subscriptions, message);
  }
}
document.querySelector("#logout")?.addEventListener("click", async () => {
  const button = document.querySelector("#logout"); button.disabled = true;
  try { await logoutFirebase(); } finally { location.href = "/login"; }
});
loadDashboard();
</script>
</BaseLayout>
