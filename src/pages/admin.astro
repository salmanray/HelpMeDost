---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Helpdesk dashboard | HelpMeDost">
<section class="page-hero"><div class="container"><span class="eyebrow">Helpdesk workspace</span><h1>Request dashboard</h1><p>Secure staff workspace. Sign in with your authorised admin email and password or Google account.</p></div></section>
<section class="container" style="margin-bottom:80px">
<div class="form-shell"><div id="admin-identity">Checking admin session…</div><div class="form-actions"><button class="button" id="load-requests">Load requests →</button><button class="button button-light" id="sign-out">Sign out</button><span class="form-message" id="admin-message" role="status"></span></div></div>
<div class="form-shell"><a class="button button-light" href="/admin-paid-queries">Paid query responses →</a> <a class="button button-light" href="/admin-subscription-queries">Subscription query responses →</a></div><div class="form-shell" id="circular-management">
<h2 style="margin-bottom:8px">Circular Management</h2><p class="hint">PDFs are stored in Google Drive; HelpMeDost stores their metadata and Drive file IDs.</p>
<div class="form-actions"><a class="button button-light" href="/api/admin/google-drive/connect">Connect Google Drive →</a><button class="button button-light" id="archive-expired">Process expired circulars</button><a class="button button-light" href="/circulars" target="_blank">Public circulars ↗</a><a class="button button-light" href="/archive" target="_blank">Archive ↗</a></div>
<form id="circular-upload" class="form-grid" style="margin-top:22px">
<div class="field full"><label for="c-title">Circular title</label><input id="c-title" name="title" required minlength="3" maxlength="240"></div>
<div class="field full"><label for="c-summary">Short summary</label><textarea id="c-summary" name="summary" maxlength="1200"></textarea></div>
<div class="field"><label for="c-category">Category</label><input id="c-category" name="category" required maxlength="80" placeholder="Admissions, Examination, Recruitment…"></div>
<div class="field"><label for="c-date">Issue date</label><input id="c-date" name="issue_date" type="date" required></div>
<div class="field"><label for="c-type">Notification type</label><select id="c-type" name="notification_type"><option value="temporary">Temporary (expires)</option><option value="permanent">Permanent (manual removal)</option><option value="custom">Custom expiry</option></select></div>
<div class="field" id="c-expiry-wrap"><label for="c-expiry">Expiry date &amp; time</label><input id="c-expiry" name="expires_at" type="datetime-local"></div>
<div class="field full"><label for="c-file">PDF file (max 20 MB)</label><input id="c-file" name="file" type="file" accept="application/pdf,.pdf" required></div>
<div class="field full"><label class="consent"><input type="checkbox" id="c-publish" checked> Publish immediately after upload</label></div>
<div class="field full"><div class="form-actions"><button class="button" type="submit" id="c-submit">Upload circular →</button><span class="form-message" id="c-message" role="status"></span></div></div>
</form><div id="circular-admin-list" class="admin-list" style="margin-top:22px"></div></div><div id="request-list" class="admin-list"></div>
</section>
<script>
import { logoutFirebase } from "../scripts/firebase-client";
const identity=document.querySelector("#admin-identity"),loadButton=document.querySelector("#load-requests"),logout=document.querySelector("#sign-out"),message=document.querySelector("#admin-message"),list=document.querySelector("#request-list");
async function checkAdmin(){const r=await fetch("/api/auth/me");const d=await r.json();if(!r.ok||d.user?.purpose!=="admin"||d.user?.user_type!=="admin"){location.href="/admin-login";return false;}identity.textContent="Signed in as "+d.user.full_name+" ("+d.user.email+")";return true;}
async function loadRequests(){message.textContent="";list.replaceChildren();loadButton.disabled=true;loadButton.textContent="Loading…";try{const response=await fetch("/api/admin/requests");const body=await response.json();if(!response.ok)throw Error(body.error||"Could not load requests.");if(!body.requests.length){list.innerHTML="<div class='empty-state'>No requests have been submitted yet.</div>";return;}body.requests.forEach(item=>{const card=document.createElement("article");card.className="admin-item";const info=document.createElement("div"),title=document.createElement("h3"),detail=document.createElement("p"),desc=document.createElement("p"),meta=document.createElement("small");title.textContent=item.subject;detail.textContent=item.reference_code+" · "+item.requester_name+" · "+(item.requester_phone||"No phone");desc.textContent=item.description;meta.className="hint";meta.textContent=new Date(item.created_at).toLocaleString();info.append(title,detail,desc,meta);const controls=document.createElement("div"),select=document.createElement("select");["submitted","under_review","waiting_for_user","resolved","closed"].forEach(status=>{const option=document.createElement("option");option.value=status;option.textContent=status.replaceAll("_"," ");option.selected=status===item.status;select.append(option);});select.addEventListener("change",async()=>{select.disabled=true;try{const update=await fetch("/api/admin/requests",{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:item.id,status:select.value})});const result=await update.json();if(!update.ok)throw Error(result.error||"Update failed");}catch(error){message.textContent=error.message;select.value=item.status;}finally{select.disabled=false;}});controls.append(select);card.append(info,controls);list.append(card);});}catch(error){message.textContent=error.message||"Something went wrong.";}finally{loadButton.disabled=false;loadButton.textContent="Load requests →";}}
const circularForm=document.querySelector("#circular-upload"),cType=document.querySelector("#c-type"),expiryWrap=document.querySelector("#c-expiry-wrap"),cExpiry=document.querySelector("#c-expiry"),cMessage=document.querySelector("#c-message"),cList=document.querySelector("#circular-admin-list"),cSubmit=document.querySelector("#c-submit");
function syncExpiry(){const permanent=cType.value==="permanent";expiryWrap.hidden=permanent;cExpiry.required=!permanent;if(permanent)cExpiry.value="";}
cType?.addEventListener("change",syncExpiry);syncExpiry();
async function loadCirculars(){if(!cList)return;cList.textContent="Loading circulars…";try{const r=await fetch("/api/admin/circulars",{cache:"no-store"}),d=await r.json();if(!r.ok)throw Error(d.error);cList.replaceChildren();if(!d.circulars.length){cList.textContent="No circulars uploaded yet.";return;}d.circulars.forEach(item=>{const card=document.createElement("article");card.className="admin-item";const info=document.createElement("div"),h=document.createElement("h3"),p=document.createElement("p"),meta=document.createElement("small");h.textContent=item.title;p.textContent=item.category+" · "+item.notification_type+" · "+item.status;meta.className="hint";meta.textContent="Issue date: "+item.issue_date+(item.expires_at?" · Expires: "+new Date(item.expires_at).toLocaleString():" · No expiry");info.append(h,p,meta);const controls=document.createElement("div"),action=document.createElement("button");action.className="button button-light";action.textContent=item.status==="published"?"Unpublish":"Republish";action.disabled=item.status==="archived"&&item.expires_at&&new Date(item.expires_at)<=new Date();action.addEventListener("click",async()=>{action.disabled=true;try{const a=item.status==="published"?"unpublish":"republish",u=await fetch("/api/admin/circulars",{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:item.id,action:a})}),v=await u.json();if(!u.ok)throw Error(v.error);await loadCirculars();}catch(e){cMessage.textContent=e.message;action.disabled=false;}});controls.append(action);if(item.active_object_key||item.archive_object_key){const link=document.createElement("a");link.href="https://drive.google.com/file/d/"+encodeURIComponent(item.archive_object_key||item.active_object_key)+"/view";link.target="_blank";link.rel="noopener noreferrer";link.textContent="Open PDF";link.style.display="block";link.style.marginTop="8px";controls.append(link);}card.append(info,controls);cList.append(card);});}catch(e){cList.textContent=e.message||"Unable to load circulars.";}}
circularForm?.addEventListener("submit",async e=>{e.preventDefault();cMessage.textContent="Uploading PDF to Google Drive…";cSubmit.disabled=true;try{const data=new FormData(circularForm);if(!document.querySelector("#c-publish").checked)data.set("publish","false");const expiryValue=data.get("expires_at");if(expiryValue)data.set("expires_at",new Date(String(expiryValue)).toISOString());const r=await fetch("/api/admin/circulars",{method:"POST",body:data}),d=await r.json();if(!r.ok)throw Error(d.error);cMessage.textContent="Circular uploaded and published.";cMessage.dataset.state="success";circularForm.reset();syncExpiry();await loadCirculars();}catch(e){cMessage.textContent=e.message||"Upload failed.";cMessage.dataset.state="error";}finally{cSubmit.disabled=false;}});
document.querySelector("#archive-expired")?.addEventListener("click",async e=>{const button=e.currentTarget;button.disabled=true;button.textContent="Processing…";try{const r=await fetch("/api/admin/circulars/archive-expired",{method:"POST"}),d=await r.json();if(!r.ok)throw Error(d.error);cMessage.textContent="Archived: "+d.processed+" · Failed: "+d.failed;cMessage.dataset.state=d.failed?"error":"success";await loadCirculars();}catch(e){cMessage.textContent=e.message;cMessage.dataset.state="error";}finally{button.disabled=false;button.textContent="Process expired circulars";}});
loadCirculars();
loadButton?.addEventListener("click",loadRequests);logout?.addEventListener("click",async()=>{await logoutFirebase();location.href="/admin-login";});checkAdmin().then(ok=>{if(ok)loadRequests();});
</script>
</BaseLayout>