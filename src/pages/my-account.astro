---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="My HelpMeDost account">
<section class="page-hero"><div class="container"><span class="eyebrow">Your account</span><h1>Payments and requests</h1><p>See your paid queries, responses, subscriptions and refund status.</p></div></section>
<section class="container" style="padding-bottom:72px"><div id="identity" class="form-shell">Loading account…</div><h2>Paid queries</h2><div id="queries" class="admin-list"></div><h2>Subscriptions</h2><div id="subscriptions" class="admin-list"></div><h2>Queries using subscription credits</h2><div id="credit-queries" class="admin-list"></div></section>
<script>
const identity=document.querySelector("#identity"),queries=document.querySelector("#queries"),subs=document.querySelector("#subscriptions"),creditQueries=document.querySelector("#credit-queries");
function make(tag,text){const e=document.createElement(tag);if(text)e.textContent=text;return e;}
async function load(){try{const me=await fetch("/api/auth/me"),who=await me.json();if(!me.ok||who.user?.purpose!=="user"){location.href="/login?next=%2Fmy-account";return;}identity.textContent="Signed in as "+who.user.full_name+" ("+who.user.email+")";const r=await fetch("/api/payments/mine"),d=await r.json();if(!r.ok)throw Error(d.error||"Unable to load account.");
 if(!d.queries.length)queries.textContent="No paid queries yet.";else d.queries.forEach(q=>{const card=make("article");card.className="admin-item";const info=make("div");info.append(make("h3",q.subject),make("p",q.reference_code+" · ₹"+q.amount_inr+" · "+q.payment_status+" · refund: "+q.refund_status),make("p",q.description));if(q.response_message)info.append(make("p","HelpMeDost response: "+q.response_message));else if(q.payment_status==="paid")info.append(make("p","No response has been recorded yet."));if(q.payment_status==="paid"&&!q.response_message){const b=make("button","Request full refund (if 3 working days passed)");b.className="button button-light";b.addEventListener("click",async()=>{b.disabled=true;try{const x=await fetch("/api/payments/refund",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({referenceCode:q.reference_code})}),y=await x.json();if(!x.ok)throw Error(y.error||"Refund request failed.");b.textContent=y.status==="processed"?"Refund processed":"Refund requested";}catch(e){b.disabled=false;alert(e.message||"Refund request failed.");}});info.append(b);}card.append(info);queries.append(card);});
 if(!d.subscriptions.length)subs.textContent="No subscriptions yet.";else d.subscriptions.forEach(s=>{const card=make("article");card.className="admin-item";const info=make("div");info.append(make("h3",s.plan_name+" · "+s.status),make("p",s.reference_code+" · "+s.query_credits_remaining+" credits remaining · "+s.query_credits+" each billing period · "+s.payment_status));if(s.status==="active"&&Number(s.query_credits_remaining)>0){const use=make("a","Use a query credit →");use.href="/subscription-help";use.className="button";info.append(use);}if(s.ends_at)info.append(make("p","Current period ends "+new Date(s.ends_at).toLocaleString()));if(["pending_payment","active"].includes(s.status)){const b=make("button",s.status==="active"?"Cancel renewal":"Cancel subscription");b.className="button button-light";b.addEventListener("click",async()=>{if(!confirm("Cancel this subscription at the end of the current billing cycle?"))return;b.disabled=true;try{const x=await fetch("/api/payments/cancel-subscription",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({referenceCode:s.reference_code})}),y=await x.json();if(!x.ok)throw Error(y.error||"Cancellation failed.");b.textContent="Cancellation requested";}catch(e){b.disabled=false;alert(e.message||"Cancellation failed.");}});info.append(b);}card.append(info);subs.append(card);});
 if(!d.creditQueries.length)creditQueries.textContent="No subscription-credit queries yet.";else d.creditQueries.forEach(q=>{const card=make("article"),info=make("div");card.className="admin-item";info.append(make("h3",q.subject),make("p",q.reference_code+" · "+q.status),make("p",q.response_message?"HelpMeDost response: "+q.response_message:"No response recorded yet."));card.append(info);creditQueries.append(card);});
 }catch(e){identity.textContent=e.message||"Unable to load account.";}}
load();
</script>
</BaseLayout>
