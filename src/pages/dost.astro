---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Dost AI | HelpMeDost" description="A short free preview with Dost AI, with an option to request human help.">
<section class="page-hero"><div class="container"><span class="eyebrow">Dost AI · Human Help When You Need It</span><h1>Your Digital Assistant.</h1><p>Start with a two-minute AI preview. If you need a person, send your conversation to the HelpMeDost Human Helpdesk.</p></div></section>
<section class="container dost-shell" aria-label="Dost AI chat">
  <div class="dost-card">
    <header class="dost-header"><div class="dost-avatar" aria-hidden="true">d</div><div class="dost-headline"><h2>Dost AI</h2><p>Your Digital Assistant. Human Help When You Need It.</p></div><div id="mode-pill" class="dost-pill">AI preview</div></header>
    <div class="dost-session-bar"><label for="category">What do you need help with?</label><select id="category" aria-label="Service category"><option value="">Loading categories…</option></select><div class="dost-time"><span>Free preview</span><strong id="timer" aria-live="off">02:00</strong></div></div>
    <div id="chat-log" class="dost-log" role="log" aria-live="polite" aria-relevant="additions text"><div class="dost-welcome"><strong>Namaste! I’m Dost.</strong><p>Tell me a little about what you need. Please avoid sharing passwords, OTPs, payment details, or unnecessary personal information.</p><p class="dost-timestamp">Dost AI · now</p></div></div>
    <div id="typing" class="dost-typing hidden" aria-live="polite"><span></span><span></span><span></span><em>Dost is thinking…</em></div>
    <div id="dost-notice" class="dost-notice" role="status"></div>
    <form id="chat-form" class="dost-compose hidden"><label class="sr-only" for="chat-message">Your message</label><textarea id="chat-message" maxlength="2000" rows="2" placeholder="Write your message… / अपना सवाल लिखें…" required></textarea><button class="button" id="send-message" type="submit" aria-label="Send message">Send ↑</button></form>
    <div id="start-panel" class="dost-actions"><p>Choose a service category to begin your one-time free 2-minute preview.</p><button class="button" id="start-chat" type="button">Start free preview →</button></div>
    <section id="ended-panel" class="dost-ended hidden" aria-labelledby="ended-title"><h3 id="ended-title">Your free chat session has ended.</h3><p>Continue with a Paid Question or request assistance from our Human Helpdesk. The preview is not a complete consultation or a guaranteed resolution.</p><div class="dost-action-row"><a class="button" href="/paid-help">Ask a Paid Question →</a><button class="button button-light" id="request-human-ended" type="button">Request Human Assistance</button></div></section>
    <div id="human-panel" class="dost-human"><button class="button button-light" id="request-human" type="button">Request Human Assistance</button><p>We’ll save your request for the HelpMeDost team. Staff availability and response times can vary.</p></div>
  </div>
  <p class="dost-privacy">Your chat is saved to your HelpMeDost account so you can return to it. It is shared with an AI provider only when AI is enabled; unnecessary contact details are removed from AI context. This service is not emergency, legal, medical, or counselling care. If chat is unavailable, <a href="/request-help">submit a standard help request</a>.</p>
</section>
<style>
.dost-shell{max-width:850px;padding-bottom:70px}.dost-card{background:#fff;border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:0 18px 45px #263d750a}.dost-header{display:flex;align-items:center;gap:13px;padding:18px 22px;border-bottom:1px solid var(--line)}.dost-avatar{width:45px;height:45px;border-radius:15px;background:var(--blue);color:#fff;display:grid;place-items:center;font:800 30px Manrope}.dost-headline{flex:1}.dost-headline h2{font-size:19px;letter-spacing:-.3px}.dost-headline p{font-size:12px;color:var(--muted);margin:3px 0 0}.dost-pill{background:#e6f8f0;color:#16845f;border-radius:20px;padding:6px 10px;font-size:11px;font-weight:800;white-space:nowrap}.dost-session-bar{display:flex;align-items:center;gap:14px;padding:14px 22px;background:#fafbff;border-bottom:1px solid var(--line)}.dost-session-bar label{font-size:12px;font-weight:700}.dost-session-bar select{max-width:260px;min-width:150px;border:1px solid #dfe3ed;border-radius:9px;padding:9px 10px;background:white;color:var(--ink)}.dost-time{margin-left:auto;display:grid;text-align:right;line-height:1.2}.dost-time span{color:var(--muted);font-size:10px}.dost-time strong{font-variant-numeric:tabular-nums;font-size:18px;color:var(--blue)}.dost-log{height:min(52vh,470px);min-height:280px;overflow:auto;padding:22px;background:linear-gradient(#fbfcff,#f7f8fc);display:flex;flex-direction:column;gap:12px}.dost-welcome{max-width:82%;align-self:flex-start;background:#fff;border:1px solid var(--line);border-radius:4px 16px 16px 16px;padding:14px 16px;font-size:14px;white-space:pre-wrap}.dost-welcome p{margin:6px 0 0;color:var(--muted)}.dost-message{max-width:82%;border-radius:16px;padding:12px 15px;font-size:14px;white-space:pre-wrap;overflow-wrap:anywhere}.dost-message.user{align-self:flex-end;background:var(--blue);color:white;border-radius:16px 4px 16px 16px}.dost-message.assistant,.dost-message.system{align-self:flex-start;background:#fff;border:1px solid var(--line);border-radius:4px 16px 16px 16px}.dost-message.staff{align-self:flex-start;background:#e6f8f0;border:1px solid #cceede}.dost-message time{display:block;font-size:10px;opacity:.68;margin-top:6px}.dost-typing{padding:0 22px 12px;color:var(--muted);font-size:12px}.dost-typing span{display:inline-block;width:6px;height:6px;border-radius:50%;background:#8995b2;margin-right:4px;animation:dost-dot 1s infinite alternate}.dost-typing span:nth-child(2){animation-delay:.2s}.dost-typing span:nth-child(3){animation-delay:.4s}.dost-typing em{font-style:normal;margin-left:5px}@keyframes dost-dot{to{opacity:.25;transform:translateY(-3px)}}.dost-compose{display:flex;gap:10px;padding:14px 18px;border-top:1px solid var(--line)}.dost-compose textarea{resize:vertical;min-height:48px;max-height:140px;flex:1;border:1px solid #dfe3ed;border-radius:12px;padding:12px;font:14px "DM Sans"}.dost-actions,.dost-human,.dost-ended{padding:16px 22px;border-top:1px solid var(--line)}.dost-actions{display:flex;align-items:center;justify-content:space-between;gap:16px}.dost-actions p,.dost-human p,.dost-ended p{font-size:12px;color:var(--muted);margin:0}.dost-human{display:flex;align-items:center;gap:14px}.dost-ended{background:#fffaf4;border-top-color:#f5e5d0}.dost-ended h3{font-size:18px;margin-bottom:7px}.dost-action-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}.dost-notice{padding:0 22px;color:#a74635;font-size:13px}.dost-privacy{font-size:11px;color:var(--muted);margin:12px 4px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.hidden{display:none!important}@media(max-width:600px){.dost-header,.dost-session-bar{padding-left:15px;padding-right:15px}.dost-session-bar{flex-wrap:wrap}.dost-session-bar select{flex:1}.dost-time{min-width:72px}.dost-log{padding:15px;min-height:260px}.dost-compose{padding:12px}.dost-actions,.dost-human,.dost-ended{padding:14px 15px}.dost-actions,.dost-human{align-items:flex-start;flex-direction:column}.dost-message,.dost-welcome{max-width:93%}}
</style>
<script>
import "../scripts/dost-client.ts";
</script>
</BaseLayout>
