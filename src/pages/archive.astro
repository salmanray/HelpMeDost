---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Circular Archive | HelpMeDost" description="Search archived circulars by title, category and year.">
<section class="page-hero"><div class="container"><span class="eyebrow">Past notifications</span><h1>Circular Archive</h1><p>Find previously published circulars. Archived PDFs remain available for reference.</p></div></section>
<section class="container archive-page"><div class="archive-toolbar"><input id="archive-search" type="search" placeholder="Search archived circulars…" aria-label="Search archive"><input id="archive-category" type="text" placeholder="Category (optional)" aria-label="Category"><input id="archive-year" type="number" min="2000" max="2100" placeholder="Year" aria-label="Year"><button class="button" id="archive-filter">Search</button></div><p id="archive-status" class="hint" role="status">Loading archive…</p><div id="archive-list" class="archive-list"></div><p><a href="/circulars">← Back to current circulars</a></p></section>
<style>
.archive-page{padding-bottom:80px}.archive-toolbar{display:grid;grid-template-columns:1.5fr 1fr .6fr auto;gap:10px}.archive-toolbar input{min-width:0;border:1px solid #dfe3ed;border-radius:10px;padding:12px;font:14px "DM Sans"}.archive-list{display:grid;gap:12px;margin:16px 0}.archive-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px}.archive-card h2{font-size:17px;letter-spacing:-.3px}.archive-card p{font-size:13px;color:var(--muted)}.archive-card a{color:#078b42;font-weight:800;font-size:13px}@media(max-width:650px){.archive-toolbar{grid-template-columns:1fr 1fr}.archive-toolbar input:first-child{grid-column:1/-1}.archive-toolbar button{grid-column:1/-1}}
</style>
<script>
const list=document.querySelector("#archive-list"),status=document.querySelector("#archive-status");function esc(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
async function load(){const p=new URLSearchParams();const q=document.querySelector("#archive-search").value.trim(),c=document.querySelector("#archive-category").value.trim(),y=document.querySelector("#archive-year").value.trim();if(q)p.set("q",q);if(c)p.set("category",c);if(y)p.set("year",y);status.textContent="Searching…";try{const r=await fetch("/api/archive?"+p,{cache:"no-store"}),d=await r.json();if(!r.ok)throw Error(d.error);list.replaceChildren();status.textContent=d.circulars.length+" archived circular(s)";if(!d.circulars.length)status.textContent="No archived circulars found.";for(const x of d.circulars){const card=document.createElement("article");card.className="archive-card";card.innerHTML=`<h2>${esc(x.title)}</h2><p>${esc(x.summary)}</p><p>${esc(x.category)} · Issued: ${esc(x.issue_date)} · Archived: ${esc(x.archived_at?new Date(x.archived_at).toLocaleDateString("en-IN"):"—")}</p><a target="_blank" rel="noopener noreferrer" href="https://drive.google.com/file/d/${encodeURIComponent(x.archive_object_key||x.active_object_key||"")}/view">View / Download PDF ↗</a>`;list.append(card);}}catch(e){status.textContent=e.message||"Could not load archive.";}}
document.querySelector("#archive-filter").addEventListener("click",load);document.querySelector("#archive-search").addEventListener("keydown",e=>{if(e.key==="Enter")load()});load();
</script>
</BaseLayout>
