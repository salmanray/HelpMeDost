---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Admin sign in | HelpMeDost">
<section class="page-hero"><div class="container"><span class="eyebrow">Staff access</span><h1>Admin sign in</h1><p>Only authorised admin accounts can access the helpdesk.</p></div></section>
<section class="container track-shell"><div class="form-shell">
<button class="button" id="google" type="button">Continue with Google</button>
<p style="text-align:center;margin:18px 0">— or use admin email and password —</p>
<form id="admin-form">
<div class="field"><label for="email">Authorised admin email</label><input id="email" type="email" required autocomplete="username" placeholder="admin@example.com"/></div>
<div class="field"><label for="password">Password</label><input id="password" type="password" required autocomplete="current-password"/></div>
<div class="form-actions"><button class="button" type="submit">Sign in to dashboard →</button><button class="button button-light" id="reset" type="button">Forgot password?</button></div>
<p class="form-message" id="message" role="status"></p>
</form></div></section>
<script>
import { loginWithEmail, loginWithGoogle, sendPasswordReset, finishHelpMeDostSession } from "../scripts/firebase-client";
const message=document.querySelector("#message"),email=document.querySelector("#email"),password=document.querySelector("#password");
document.querySelector("#google")?.addEventListener("click",async()=>{try{const user=await loginWithGoogle();await finishHelpMeDostSession(user,{mode:"login",purpose:"admin"});}catch(error){message.textContent=error.message||"Admin sign-in failed."; }});
document.querySelector("#admin-form")?.addEventListener("submit",async event=>{event.preventDefault();try{const user=await loginWithEmail(email.value,password.value);await finishHelpMeDostSession(user,{mode:"login",purpose:"admin"});}catch(error){message.textContent=error.message||"Admin sign-in failed."; }});
document.querySelector("#reset")?.addEventListener("click",async()=>{try{if(!email.value)throw new Error("Enter your admin email first.");await sendPasswordReset(email.value);message.textContent="Password reset email sent."; }catch(error){message.textContent=error.message||"Could not send reset email."; }});
</script>
</BaseLayout>