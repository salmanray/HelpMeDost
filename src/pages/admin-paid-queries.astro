---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Paid assistance | HelpMeDost admin">
<section class="page-hero"><div class="container"><span class="eyebrow">Helpdesk workspace</span><h1>Paid query responses</h1><p>Post the first response here. Saving it starts the response record used by the three-working-day refund rule.</p><a class="button button-light" href="/admin">Back to requests</a></div></section>
<section class="container" style="padding-bottom:72px"><div class="form-shell"><div id="identity">Checking admin session…</div><div class="form-actions"><button class="button" id="reload">Load paid queries →</button><span class="form-message" id="message" role="status"></span></div></div><div id="items" class="admin-list"></div></section>
<script>
const identity=document.querySelector("#identity"),reload=document.querySelector("#reload"),message=document.querySelector("#message"),items=document.querySelector("#items");
async function check(){const r=await fetch("/api/auth/me"),d=await r.json();if(!r.ok||d.user?.purpose!=="admin"||d.user?.user_type!=="admin"){location.href="/admin-login";return false;}identity.textContent="Signed in as "+d.user.email;return true;}
async function load(){items.replaceChildren();message.textContent="";try{const r=await fetch("/api/admin/paid-queries"),d=await r.json();if(!r.ok)throw Error(d.error||"Could not load queries.");if(!d.queries.length){items.textContent="No paid queries yet.";return;}d.queries.forEach(q=>{const card=document.createElement("article");card.className="admin-item";const info=document.createElement("div"),h=document.createElement("h3"),meta=document.createElement("p"),desc=document.createElement("p"),area=document.createElement("textarea"),save=document.createElement("button"),status=document.createElement("small");h.textContent=q.subject;meta.textContent=q.reference_code+" · "+q.customer_name+" · "+q.customer_email+" · ₹"+q.amount_inr+" · "+q.payment_status;desc.textContent=q.description;area.maxLength=4000;area.placeholder="Write the customer-facing first response";area.value=q.response_message||"";save.className="button";save.textContent=q.first_response_at?"Update response":"Send first response";status.className="hint";status.textContent=q.first_response_at?"First response recorded "+new Date(q.first_response_at).toLocaleString():"No response recorded";save.addEventListener("click",async()=>{save.disabled=true;try{const u=await fetch("/api/admin/paid-queries",{method:"PATCH",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:q.id,response:area.value})}),v=await u.json();if(!u.ok)throw Error(v.error||"Could not save response.");status.textContent="First response recorded "+new Date().toLocaleString();save.textContent="Update response";}catch(e){message.textContent=e.message||"Could not save.";}finally{save.disabled=false;}});info.append(h,meta,desc,area,status,save);card.append(info);items.append(card);});}catch(e){message.textContent=e.message||"Unable to load paid queries.";}}
reload?.addEventListener("click",load);check().then(ok=>{if(ok)load();});
</script>
</BaseLayout>
