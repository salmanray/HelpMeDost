---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Create account | HelpMeDost">
<section class="page-hero"><div class="container"><span class="eyebrow">Get started</span><h1>Create your HelpMeDost account</h1><p>Register with your name and email. Verify your email to activate your account.</p></div></section>
<section class="container track-shell"><form class="form-shell" id="auth-form">
<div class="field"><label for="name">Full name</label><input id="name" required maxlength="120" autocomplete="name" placeholder="Your name"/></div>
<div class="field"><label for="email">Email address</label><input id="email" type="email" required autocomplete="email" placeholder="you@example.com"/></div>
<div class="field" id="otp-field" hidden><label for="otp">6-digit email code</label><input id="otp" inputmode="numeric" maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code" placeholder="000000"/></div>
<div class="form-actions"><button class="button" id="send" type="button">Verify email →</button><button class="button" id="verify" type="submit" hidden>Create account →</button><span class="form-message" id="message" role="status"></span></div>
<p class="hint">Already registered? <a href="/login">Sign in</a></p>
</form></section>
<script>
const form=document.querySelector("#auth-form"),email=document.querySelector("#email"),name=document.querySelector("#name"),otp=document.querySelector("#otp"),otpField=document.querySelector("#otp-field"),send=document.querySelector("#send"),verify=document.querySelector("#verify"),message=document.querySelector("#message");
send?.addEventListener("click",async()=>{message.textContent="";try{const r=await fetch("/api/auth/request-otp",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:email.value,name:name.value,purpose:"user",mode:"register"})});const d=await r.json();if(!r.ok)throw Error(d.error);otpField.hidden=false;verify.hidden=false;send.hidden=true;message.textContent=d.message;}catch(e){message.textContent=e.message||"Unable to send code.";}});
form?.addEventListener("submit",async e=>{e.preventDefault();try{const r=await fetch("/api/auth/verify-otp",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:email.value,name:name.value,otp:otp.value,purpose:"user"})});const d=await r.json();if(!r.ok)throw Error(d.error);location.href=d.redirectTo;}catch(e){message.textContent=e.message||"Verification failed."; }});
</script>
</BaseLayout>
