---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Latest Circulars | HelpMeDost" description="Browse current public notices and circulars.">
<section class="page-hero"><div class="container"><span class="eyebrow">Official updates</span><h1>Latest Circulars</h1><p>Browse published notifications and download the original PDF. Always verify important deadlines with the issuing department.</p></div></section>
<section class="container circular-page">
  <div class="circular-toolbar"><input id="circular-search" type="search" placeholder="Search circulars…" aria-label="Search circulars"><select id="circular-category" aria-label="Filter by category"><option value="">All categories</option></select><select id="circular-year" aria-label="Filter by year"><option value="">All years</option></select><a class="button button-light" href="/archive">View Archive →</a></div>
  <p id="circular-status" class="hint" role="status">Loading circulars…</p><div id="circular-list" class="circular-grid"></div>
</section>
<style>
.circular-page{padding-bottom:80px}.circular-toolbar{display:grid;grid-template-columns:1.5fr 1fr .7fr auto;gap:10px;margin:12px 0 18px}.circular-toolbar input,.circular-toolbar select{border:1px solid #dfe3ed;border-radius:10px;padding:12px;background:#fff;font:14px "DM Sans";min-width:0}.circular-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.circular-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px}.circular-card h2{font-size:18px;letter-spacing:-.4px}.circular-card p{font-size:13px;color:var(--muted)}.circular-meta{display:flex;gap:8px;flex-wrap:wrap;color:#71809a;font-size:11px;margin:12px 0}.circular-tag{background:#eef3ff;color:#3659d9;padding:4px 8px;border-radius:20px;font-weight:700}.circular-card a{display:inline-flex;margin-top:6px;color:#078b42;font-weight:800;font-size:13px}@media(max-width:700px){.circular-toolbar{grid-template-columns:1fr 1fr}.circular-toolbar input{grid-column:1/-1}.circular-toolbar a{grid-column:1/-1}.circular-grid{grid-template-columns:1fr}}
</style>
<script>
const list=document.querySelector("#circular-list"),status=document.querySelector("#circular-status"),search=document.querySelector("#circular-search"),category=document.querySelector("#circular-category"),year=document.querySelector("#circular-year");let timer;
function esc(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
async function load(){status.textContent="Loading circulars…";const params=new URLSearchParams();if(search.value.trim())params.set("q",search.value.trim());if(category.value)params.set("category",category.value);if(year.value)params.set("year",year.value);try{const r=await fetch("/api/circulars?"+params,{cache:"no-store"}),d=await r.json();if(!r.ok)throw Error(d.error);list.replaceChildren();if(!d.circulars.length){status.textContent="No current circulars found.";return;}status.textContent=d.circulars.length+" circular(s)";for(const c of d.circulars){const card=document.createElement("article");card.className="circular-card";const date=new Date(c.issue_date+"T00:00:00").toLocaleDateString("en-IN");card.innerHTML=`<h2>${esc(c.title)}</h2><p>${esc(c.summary)}</p><div class="circular-meta"><span class="circular-tag">${esc(c.category)}</span><span>Issued: ${esc(date)}</span><span>${esc(c.notification_type)}</span></div><a target="_blank" rel="noopener noreferrer" href="https://drive.google.com/file/d/${encodeURIComponent(c.active_object_key||"")}/view">View / Download PDF ↗</a>`;list.append(card);}const cats=[...new Set(d.circulars.map(c=>c.category))],years=[...new Set(d.circulars.map(c=>String(new Date(c.issue_date).getFullYear())))];for(const [el,values] of [[category,cats],[year,years]]){const old=el.value;el.querySelectorAll("option:not(:first-child)").forEach(o=>o.remove());values.sort().forEach(v=>{const o=document.createElement("option");o.value=v;o.textContent=v;el.append(o)});el.value=old;}}catch(e){status.textContent=e.message||"Could not load circulars.";}}
search.addEventListener("input",()=>{clearTimeout(timer);timer=setTimeout(load,250)});category.addEventListener("change",load);year.addEventListener("change",load);load();
</script>
</BaseLayout>
