---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Plans & pricing | HelpMeDost" description="Choose free guidance, pay-per-query assistance or a HelpMeDost subscription.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Simple and transparent</span><h1>Help that fits your needs.</h1><p>Start free, pay only when you need individual assistance, or choose a subscription if you need help regularly. No forced upgrades.</p></div></section>
  <section class="container" style="padding-bottom:72px">
    <div class="service-grid pricing-grid">
      <article class="service-card pricing-card">
        <div class="service-icon">🌱</div><span class="eyebrow">Start here</span><h2>Free</h2><p class="price">₹0 <small>/ always</small></p>
        <p>For people who need basic information and a first direction.</p>
        <ul><li>Basic guidance and public information</li><li>Official links and useful resources</li><li>Submit a standard help request</li></ul>
        <a class="button button-light" href="/request-help">Ask a free query →</a>
      </article>
      <article class="service-card pricing-card featured-plan">
        <div class="plan-tag">Flexible option</div><div class="service-icon">💬</div><span class="eyebrow">One-time assistance</span><h2>Pay per query</h2><p class="price">₹49–299 <small>/ query</small></p>
        <p>For people who need help with one specific issue without a subscription.</p>
        <ul><li>Personalised guidance: ₹49</li><li>Detailed assistance: ₹99–199</li><li>Document/application review: ₹149–299</li></ul>
        <a class="button" href="/request-help">Describe your query →</a>
      </article>
      <article class="service-card pricing-card">
        <div class="service-icon">⭐</div><span class="eyebrow">Regular support</span><h2>Premium</h2><p class="price">From ₹99 <small>/ month</small></p>
        <p>For users who expect to need assistance more than once.</p>
        <ul><li>Monthly: ₹99 — 5 eligible queries</li><li>Quarterly: ₹249 — 15 eligible queries</li><li>Annual: ₹799 — 60 eligible queries</li><li>Priority response, subject to service hours</li></ul>
        <a class="button button-light" href="#subscription-note">Subscription details →</a>
      </article>
    </div>
    <div class="form-shell pricing-note" id="subscription-note">
      <h2>Payments are being prepared</h2>
      <p>These are proposed launch prices. Online payment and subscription activation are not live yet. We will activate paid checkout only after secure payment verification, receipts, cancellation and refund handling are ready. Until then, no payment is collected through this page.</p>
      <p class="hint">Basic public information remains free. Any paid service will show its scope, final price and delivery terms before you choose it.</p>
      <a class="button" href="/request-help">Continue with a free query →</a>
    </div>
  </section>
</BaseLayout>
