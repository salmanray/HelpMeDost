---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/homepage.css";
---
<BaseLayout title="HelpMeDost | Student, Parent & Citizen Assistance Portal" description="A one-stop helpdesk for students, parents and citizens — education, complaints, counselling, legal guidance and cyber safety.">
  <section class="hm-reference-hero">
    <div class="hm-reference-inner">
      <div class="hm-reference-copy">
        <span class="hm-reference-pill">A One-Stop Helpdesk</span>
        <h1>Support, Guidance and Solutions for <span class="word-blue">Students</span>, <span class="word-green">Parents</span> and <span class="word-orange">Families</span></h1>
        <p>Education, Complaints, Counselling, Legal Help, Cyber Safety and Government Services – All in One Place.</p>
        <div class="hm-reference-actions"><a class="hm-reference-primary" href="/request-help">Get Help Now <b>→</b></a><a class="hm-reference-secondary" href="/dost">Ask Dost AI <b>🤖</b></a></div>
      </div>
      <div class="hm-reference-family">
        <div class="hm-family-photo-wrap"><img src="/family-hero.webp" alt="A father and children smiling together while using a laptop" loading="eager" /></div>
        <div class="hm-family-swoosh"></div>
        <div class="hm-family-service-pills">
          <a href="/request-help"><span class="service-symbol green">🎓</span>Student Help</a>
          <a href="/request-help"><span class="service-symbol green">👥</span>Counselling &amp; Wellbeing</a>
          <a href="/request-help"><span class="service-symbol orange">⚖</span>Legal Guidance</a>
          <a href="/request-help"><span class="service-symbol green">▣</span>Cyber Safety</a>
          <a href="/request-help"><span class="service-symbol blue">🏛</span>Government Work</a>
        </div>
      </div>
    </div>
  </section>

  <section class="hm-reference-services" id="services">
    <div class="hm-reference-section-head"><h2>Our Key Services</h2><a href="/request-help">View All Services <b>→</b></a></div>
    <div class="hm-reference-service-grid">
      <a href="/request-help" class="hm-ref-service"><span class="hm-ref-icon blue">🎓</span><strong>Student Support</strong><small>(Admission, EWS, etc.)</small></a>
      <a href="/request-help" class="hm-ref-service"><span class="hm-ref-icon orange">▤</span><strong>Complaint &amp;<br/>Grievance</strong></a>
      <a href="/request-help" class="hm-ref-service"><span class="hm-ref-icon green">👥</span><strong>Counselling</strong><small>(Student &amp; Parent)</small></a>
      <a href="/request-help" class="hm-ref-service"><span class="hm-ref-icon blue">⚖</span><strong>Legal Assistance</strong><small>(Guidance &amp; Support)</small></a>
      <a href="/request-help" class="hm-ref-service"><span class="hm-ref-icon blue">▣</span><strong>Cyber Help</strong><small>(Safety &amp; Awareness)</small></a>
      <a href="/request-help" class="hm-ref-service"><span class="hm-ref-icon blue">▰</span><strong>Government Jobs</strong><small>(Alerts &amp; Guidance)</small></a>
      <a href="/request-help" class="hm-ref-service"><span class="hm-ref-icon red">♥</span><strong>Mental Wellbeing</strong><small>(Stress, Exam, Life)</small></a>
      <a href="/request-help" class="hm-ref-service"><span class="hm-ref-icon orange">🤝</span><strong>Expert Connect</strong><small>(Advocate, Counsellor, etc.)</small></a>
    </div>
  </section>

  <section class="hm-reference-lower">
    <article class="hm-reference-dost">
      <div class="hm-robot-art" aria-hidden="true"><div class="robot-antenna"></div><div class="robot-head"><span>● ●</span><i>⌣</i></div><div class="robot-body"><b>h</b></div><div class="robot-hand"></div></div>
      <div class="hm-dost-content"><h2>Dost <span>AI</span></h2><h3>Your Digital Assistant</h3><ul><li>Get instant guidance</li><li>Understand processes</li><li>Find relevant resources</li></ul><a href="/dost">Ask Dost AI Now <b>→</b></a></div>
    </article>
    <article class="hm-reference-updates">
      <div class="hm-ref-panel-heading"><span>⚑</span><h2>Latest Updates &amp; Circulars</h2><a href="/request-help">View All →</a></div>
      <a href="/request-help" class="hm-ref-update"><span>▤</span><strong>Delhi Government School Admission Guidance</strong><em>Explore</em></a>
      <a href="/request-help" class="hm-ref-update"><span>▤</span><strong>EWS / DG Admission – Application Support</strong></a>
      <a href="/request-help" class="hm-ref-update"><span>▤</span><strong>Cyber Safety Awareness – Student Resources</strong></a>
      <a href="/request-help" class="hm-ref-update"><span>▤</span><strong>RTI: How to File and Track Your Application</strong></a>
      <p class="hm-update-note">Guidance topics shown here. Check official department notifications for current dates and rules.</p>
    </article>
    <article class="hm-reference-human">
      <div class="hm-human-art" aria-hidden="true"><div class="human-head"></div><div class="human-hair"></div><div class="human-headset"></div><div class="human-body"></div></div>
      <div class="hm-human-content"><span>☏</span><h2>Need Human Assistance?</h2><p>Talk to our helpdesk team for personalised support.</p><a href="/request-help">Request Human Assistance <b>→</b></a></div>
    </article>
  </section>

  <section class="hm-reference-trust">
    <div><span>👥</span><p><strong>Students &amp; Parents</strong><small>Support</small></p></div>
    <div><span>ϟ</span><p><strong>Quick Resolution</strong><small>(Track Your Request)</small></p></div>
    <div><span>🛡</span><p><strong>Safe &amp; Confidential</strong><small>(Your Data is Protected)</small></p></div>
    <div><span>♡</span><p><strong>Inclusive &amp; Accessible</strong><small>(For Everyone)</small></p></div>
  </section>
  </BaseLayout>