---
import "../styles/global.css";
const { title = "HelpMeDost | A little help goes a long way", description = "Friendly, practical assistance for students and families." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#0754ad" /><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" /></head>
<body>
<div class="hm-utility-bar"><div class="hm-utility-inner"><span>✉ <a href="mailto:support@helpmedost.in">support@helpmedost.in</a></span><span class="hm-utility-tagline">Student • Parent • Citizen Assistance Portal</span><div class="hm-utility-access" role="group" aria-label="Text size controls"><span>Text size</span><button type="button" data-font-size="decrease" aria-label="Decrease text size" title="Decrease text size">A−</button><button type="button" data-font-size="reset" aria-label="Reset text size" title="Reset text size" aria-pressed="true">A</button><button type="button" data-font-size="increase" aria-label="Increase text size" title="Increase text size">A+</button></div></div></div>
<header class="site-header"><div class="container nav-wrap">
<a class="brand" href="/" aria-label="HelpMeDost home"><span class="brand-mark">h</span><span>HelpMe<span class="brand-accent">Dost</span><small class="brand-subtitle">Student • Parent • Citizen Assistance Portal</small></span></a>
<nav aria-label="Main navigation"><a href="/">Home</a><a href="/#services">Services⌄</a><a href="/dost">Dost AI</a><a href="/complaints">Complaints</a><a href="/counselling">Counselling</a><a href="/#how-it-works">Resources⌄</a><a href="/#how-it-works">About⌄</a><a href="/track">Track Request</a></nav>
<div class="hm-header-actions">
  <a class="hm-login-link" href="/login" data-auth-link="login">Login</a>
  <a class="button button-small desktop-get-help" href="/register" data-auth-link="register">Register</a>
  <details class="hm-account-menu" data-auth-link="account" hidden>
    <summary aria-label="Open your account menu"><span class="hm-avatar" data-user-avatar>S</span><span class="hm-account-copy"><strong data-user-name>Account</strong><small><i></i> Signed in</small></span><span class="hm-account-chevron">⌄</span></summary>
    <div class="hm-account-popover"><div class="hm-account-identity"><strong data-user-fullname>Signed in</strong><span data-user-email></span><small><i></i> Signed in</small></div><a href="/account">My Dashboard</a><button type="button" data-sign-out>Sign out</button></div>
  </details>
</div>
<details class="mobile-menu"><summary aria-label="Open navigation menu"><span class="menu-icon" aria-hidden="true"></span></summary><nav class="mobile-menu-panel" aria-label="Mobile navigation">
  <div class="hm-mobile-session" data-auth-link="mobile-session" hidden><span class="hm-avatar" data-user-avatar>S</span><span class="hm-mobile-session-copy"><strong data-user-name>Account</strong><small><i></i> Signed in</small></span></a>
  <a href="/">Home</a><a href="/#services">Services</a><a href="/dost">Dost AI</a><a href="/complaints">Complaints</a><a href="/counselling">Counselling</a><a href="/#how-it-works">Resources &amp; About</a><a href="/track">Track Request</a><a href="/plans">Plans</a><a href="/account" data-auth-link="mobile-dashboard" hidden>My Dashboard</a><button type="button" class="hm-mobile-signout" data-auth-link="mobile-signout" data-sign-out hidden>Sign out</button><a href="/login" data-auth-link="login">Login</a><a href="/register" data-auth-link="register">Register</a><a class="mobile-menu-cta" href="/request-help">Get Help Now ↗</a>
</nav></details>
</div></header><main><slot /></main><footer class="site-footer"><div class="container footer-inner"><a class="brand" href="/"><span class="brand-mark">h</span><span>HelpMe<span class="brand-accent">Dost</span></span></a><p>Support, Guidance and Solutions for Students, Parents and Families.</p><span>© {new Date().getFullYear()} HelpMeDost</span><a href="/admin-login" aria-label="Staff admin sign in">Staff login</a></div><div class="container footer-note">HelpMeDost ek assistance platform hai. Yeh emergency, legal, medical ya professional services ka replacement nahi hai.</div></footer>
<script>
(async () => {
  const setText = (selector, value) => document.querySelectorAll(selector).forEach(node => node.textContent = value);
  try {
    const response = await fetch("/api/auth/me", { cache: "no-store", credentials: "same-origin" });
    const data = await response.json().catch(() => ({}));
    const user = data.user;
    if (!response.ok || !data.authenticated || user?.purpose !== "user" || user?.user_type !== "public") return;
    const name = user.full_name || "My Account";
    const email = user.email || "";
    const initials = name.trim().split(/\s+/).slice(0,2).map(part => part[0]).join("").toUpperCase() || "U";
    document.querySelectorAll('[data-auth-link="login"], [data-auth-link="register"]').forEach(link => link.hidden = true);
    document.querySelectorAll('[data-auth-link="account"], [data-auth-link="mobile-session"], [data-auth-link="mobile-dashboard"], [data-auth-link="mobile-signout"]').forEach(node => node.hidden = false);
    setText("[data-user-name]", name.split(/\s+/)[0]);
    setText("[data-user-fullname]", name);
    setText("[data-user-email]", email);
    document.querySelectorAll("[data-user-avatar]").forEach(node => node.textContent = initials);
  } catch { /* Keep guest navigation if session lookup is unavailable. */ }
})();
document.addEventListener("click", async event => {
  const button = event.target.closest("[data-sign-out]");
  if (!button) return;
  button.disabled = true;
  button.textContent = "Signing out…";
  try {
    await fetch("/api/auth/logout", { method: "POST", credentials: "same-origin" });
    location.reload();
  } catch {
    button.disabled = false;
    button.textContent = "Sign out";
  }
});
</script>
<script>
(() => {
  const root = document.documentElement;
  const key = "helpmedost-text-zoom";
  const min = 90;
  const max = 120;
  const step = 10;
  let level = 100;

  try {
    const saved = Number(localStorage.getItem(key));
    if ([90, 100, 110, 120].includes(saved)) level = saved;
  } catch { /* Storage may be unavailable; controls still work for this page view. */ }

  const apply = () => {
    root.style.zoom = (level / 100).toString();
    document.querySelectorAll("[data-font-size]").forEach((button) => {
      button.setAttribute("aria-pressed", String(
        (button.dataset.fontSize === "reset" && level === 100) ||
        (button.dataset.fontSize === "increase" && level === max) ||
        (button.dataset.fontSize === "decrease" && level === min)
      ));
      button.disabled =
        (button.dataset.fontSize === "increase" && level === max) ||
        (button.dataset.fontSize === "decrease" && level === min);
    });
  };

  document.addEventListener("click", (event) => {
    const button = event.target.closest("[data-font-size]");
    if (!button) return;
    if (button.dataset.fontSize === "increase") level = Math.min(max, level + step);
    if (button.dataset.fontSize === "decrease") level = Math.max(min, level - step);
    if (button.dataset.fontSize === "reset") level = 100;
    try { localStorage.setItem(key, String(level)); } catch { /* Non-persistent fallback. */ }
    apply();
  });

  apply();
})();
</script></body></html>