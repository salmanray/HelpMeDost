---
import "../styles/global.css";
const { title = "HelpMeDost | A little help goes a long way", description = "Friendly, practical assistance for students and families." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fc" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="HelpMeDost home"><span class="brand-mark">h</span><span>HelpMe<span class="brand-accent">Dost</span></span></a>
        <nav aria-label="Main navigation">
          <a href="/#how-it-works">How it works</a>
          <a href="/#services">What we help with</a>
          <a href="/track">Track a request</a>
          <a href="/plans">Plans & pricing</a>
        </nav>
        <a class="button button-small desktop-get-help" href="/request-help">Get help <span aria-hidden="true">↗</span></a>
        <details class="mobile-menu">
          <summary aria-label="Open navigation menu"><span class="menu-icon" aria-hidden="true"></span></summary>
          <nav class="mobile-menu-panel" aria-label="Mobile navigation">
            <a href="/">Home</a>
            <a href="/#how-it-works">How it works</a>
            <a href="/#services">What we help with</a>
            <a href="/track">Track a request</a>
            <a href="/plans">Plans & pricing</a>
            <a class="mobile-menu-cta" href="/request-help">Get help ↗</a>
          </nav>
        </details>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand" href="/"><span class="brand-mark">h</span><span>HelpMe<span class="brand-accent">Dost</span></span></a>
        <p>Good guidance. Clear next steps. A friend when you need one.</p>
        <span>© {new Date().getFullYear()} HelpMeDost</span>
        <a href="/admin" aria-label="Staff admin dashboard">Staff login</a>
      </div>
      <div class="container footer-note">HelpMeDost is an assistance platform. It does not replace emergency, legal, medical or professional services.</div>
    </footer>
  </body>
</html>
