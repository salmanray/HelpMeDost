# =============================================================================
# HelpMeDost — environment variables (Cloudflare Pages)
# =============================================================================
# NEVER commit real secrets. Configure these in the Cloudflare Pages dashboard.
#
# BUILD-TIME variables (must be available during `astro build`):
#   PUBLIC_* values are embedded in the client bundle. They are public identifiers,
#   not secrets, but they must match the Firebase Web App for this environment.
#
# RUNTIME variables (available to Pages Functions / server endpoints):
#   DATABASE_URL, FIREBASE_API_KEY, FIREBASE_PROJECT_ID, ADMIN_EMAILS
# =============================================================================

# --- Cloudflare Pages → Settings → Environment variables → Build ---
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=helpmedost-auth-test.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=helpmedost-auth-test
PUBLIC_FIREBASE_APP_ID=1:547646128261:web:ab7f5e18eebe6269da69ec

# --- Cloudflare Pages → Settings → Environment variables → Production / Preview ---
# Use the same Web API key as PUBLIC_FIREBASE_API_KEY for Identity Toolkit lookup.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=helpmedost-auth-test
# Comma-separated admin allowlist (no spaces required). Only these emails may get admin sessions.
ADMIN_EMAILS=mr.ray.rs@gmail.com

# Neon Postgres connection string (runtime)
DATABASE_URL=

# Legacy main-branch admin key (optional; not used by Firebase admin flow)
# ADMIN_ACCESS_KEY=
