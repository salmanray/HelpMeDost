# Cloudflare Pages build variables (Firebase Web App config; these are public client identifiers)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Cloudflare Pages runtime variables
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
ADMIN_EMAILS=mr.ray.rs@gmail.com

# Configure as encrypted Cloudflare Pages secrets (Test Mode keys in Preview)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Dost AI remains disabled until a Workers AI binding and free account quota are verified.
DOST_AI_ENABLED=false
DOST_AI_MODEL=@cf/google/gemma-4-26b-a4b-it

# Google Drive OAuth integration (store secrets as encrypted Cloudflare Pages secrets)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Google Drive folder IDs (non-secret configuration)
GOOGLE_DRIVE_ACTIVE_FOLDER_ID=
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=

# OAuth callback URL registered in Google Cloud Console
GOOGLE_DRIVE_REDIRECT_URI=https://helpmedost.in/api/admin/google-drive/callback

# Existing application database
DATABASE_URL=
